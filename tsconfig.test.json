{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "noEmit": false,
    "incremental": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "isolatedModules": false,
    "jsx": "react-jsx"
  },
  "include": [
    "tests/**/*.test.ts",
    "src/hooks/usePortfolioBalances.ts",
    "src/components/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".test-build"
  ]
}
