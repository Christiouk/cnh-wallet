# Existing Privy app: preserve the production App ID and dashboard policy.
NEXT_PUBLIC_PRIVY_APP_ID=your-existing-privy-app-id

# Server-only Ethereum mainnet endpoint. Never expose credentials in NEXT_PUBLIC variables.
ETHEREUM_RPC_URL=https://your-ethereum-mainnet-provider.example
# Runtime accepts existing NEXT_PUBLIC_RPC_URL on the server as a migration fallback.
# Do not change production settings as part of this branch-only task.

# Server-only history and optional price credentials.
ETHERSCAN_API_KEY=your-etherscan-v2-key
COINGECKO_API_KEY=your-coingecko-demo-key

