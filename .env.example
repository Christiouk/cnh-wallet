# Existing Privy app: preserve the production App ID and dashboard policy.
NEXT_PUBLIC_PRIVY_APP_ID=your-existing-privy-app-id

# Server-only Ethereum mainnet endpoint. Never expose credentials in NEXT_PUBLIC variables.
ETHEREUM_RPC_URL=https://your-ethereum-mainnet-provider.example
# Runtime accepts existing NEXT_PUBLIC_RPC_URL on the server as a migration fallback.
# Do not change production settings as part of this branch-only task.

# Server-only history and optional price credentials.
ETHERSCAN_API_KEY=your-etherscan-v2-key
COINGECKO_API_KEY=your-coingecko-demo-key

# Buy remains unavailable until A3-06A staging configuration and verification are complete.

# A3-05: server-only; leave empty until an approved isolated validation environment exists.
# Uses the SAME existing NEXT_PUBLIC_PRIVY_APP_ID above, never creates another application.
PRIVY_APP_SECRET=
TRONGRID_API_KEY=
A3_TRON_INTENT_SECRET=
# Explicitly off: this development branch must not create live wallets or send live funds.
A3_TRON_CREATION_ENABLED=false
A3_TRON_SEND_ENABLED=false
# Local fixture page only, ignored by production and Vercel. No live credentials needed.
A3_TRON_FIXTURE_MODE=0

# A3-06A: staging-only Buy. All values are server-only. Empty = unavailable.
# Historical NEXT_PUBLIC_TRANSAK_* values are deliberately not consumed.
A3_BUY_STAGING_ENABLED=false
TRANSAK_ENVIRONMENT=staging
TRANSAK_API_KEY=
TRANSAK_API_SECRET=
TRANSAK_REFERRER_ORIGIN=
A3_BUY_TICKET_SECRET=
# Populate only after partner-specific locking and sandbox validation.
# Allowed identifiers: ethereum:ETH,ethereum:USDT,ethereum:USDC,tron:USDT
A3_BUY_VERIFIED_PAIRS=
# Local HTTPS staging validation only: actual tester IP; ignored on Vercel.
A3_BUY_DEV_USER_IP=

# A3-06B: controlled validation only. Ethereum mainnet API; no 0x sandbox host.
# Production remains blocked in code. Never use NEXT_PUBLIC_* for this key.
ZEROX_API_KEY=
A3_SWAP_ENABLED=false
A3_SWAP_VERIFIED=false
A3_SWAP_ORIGIN=
